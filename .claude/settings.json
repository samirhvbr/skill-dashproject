{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 scripts/collect-activity.py:*)",
      "Bash(scripts/check-docs.sh:*)",
      "Bash(scripts/build-release.sh:*)",
      "Bash(scripts/pending-ready.sh:*)",
      "Read(//home/user/skill-DASHPROJECT/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets.yaml)"
    ]
  }
}
